# ── AI Trip Planner — Environment Variables ───────────────────────────────
#
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git!
#
# Usage:
#   1. cp .env.example .env
#   2. Fill in your real keys below
#   3. python serve.py    ← LangServe API  (port 8000)
#   4. python app.py      ← Flask Web UI   (port 8080)
# ─────────────────────────────────────────────────────────────────────────

# ── OpenAI ────────────────────────────────────────────────────────────────
OPENAI_API_KEY=your-openai-api-key-here

# ── Optional: LangSmith tracing (free tier available) ─────────────────────
# Uncomment to get full LLM call traces at smith.langchain.com
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your-langsmith-api-key-here
LANGCHAIN_PROJECT=trip-planner

# ── Flask  ────────────────────────────────────────────────────────────────
FLASK_ENV=development
FLASK_PORT=8080

# ── LangServe ─────────────────────────────────────────────────────────────
LANGSERVE_PORT=8000
